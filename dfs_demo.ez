// ============================================================
// CodeFab 데모: 그래프 DFS(깊이 우선 탐색) + 이 언어의 거의 모든
// 문법 요소(TokenType.md의 46개 토큰 종류)를 한 파일에서 보여준다.
// 실행: python main.py run dfs_demo.ez
//
// 각 단계마다 print로 중간 상태를 보여주므로, 출력만 따라가도
// 어디까지 정상 동작했는지 바로 확인할 수 있다.
// ============================================================

print "step 1: 보조 모듈 import";
import "dfs_demo_utils.ez" alias utils;
print "  import 완료, 모듈 이름 =";
print utils.MODULE_NAME;

// --- 클래스 선언 / 상속(:) / this / 필드 / 배열(정적 배열) ---
Class Graph {
    init(size) {
        This.size = size;
        This.adj = Array(size);
        for (var i = 0; i < size; i = i + 1) {
            This.adj[i] = Array(size);
            for (var j = 0; j < size; j = j + 1) {
                This.adj[i][j] = false;
            }
        }
    }

    addEdge(a, b) {
        This.adj[a][b] = true;
        This.adj[b][a] = true;
    }

    hasEdge(a, b) {
        return This.adj[a][b];
    }
}

// --- 상속 + super ---
Class WeightedGraph : Graph {
    addEdge(a, b) {
        Super.addEdge(a, b);
        print "  edge added:";
        print a;
        print b;
        print "  weight =";
        print utils.edgeWeight(a, b);
    }
}

print "step 2: 그래프 생성 (정점 5개)";
//      0
//     / \
//    1   2
//    |   |
//    3---4
var g = WeightedGraph(5);
print "  Graph 인스턴스인가?";
print (g instanceof Graph);         // expect: true
print "  WeightedGraph 인스턴스인가?";
print (g instanceof WeightedGraph); // expect: true

print "step 3: 간선 추가";
g.addEdge(0, 1);
g.addEdge(0, 2);
g.addEdge(1, 3);
g.addEdge(2, 4);
g.addEdge(3, 4);

// --- 전역 변수 (함수 호출이 끝나도 값이 유지된다) ---
var visitCount = 0;

// --- 함수 선언 / 재귀 호출 / return / 논리 연산자(and) / 단항(!) ---
Func dfs(graph, node, visited) {
    if (visited[node] == true) {
        return;
    }
    visited[node] = true;
    visitCount = visitCount + 1;
    print "  visit node";
    print node;

    var neighbor = 0;
    for (neighbor = 0; neighbor < graph.size; neighbor = neighbor + 1) {
        if (graph.hasEdge(node, neighbor) and !visited[neighbor]) {
            dfs(graph, neighbor, visited);
        }
    }
}

print "step 4: 방문 배열 초기화";
var visited = Array(5);
for (var i = 0; i < 5; i = i + 1) {
    visited[i] = false;
}
print "  초기 방문 배열:";
print visited;   // expect: [false, false, false, false, false]

print "step 5: DFS 시작 (시작 노드 = 0)";
dfs(g, 0, visited);
print "step 6: DFS 종료";

print "  최종 방문 배열:";
print visited;      // expect: [true, true, true, true, true]
print "  총 방문 횟수(전역 변수 visitCount):";
print visitCount;   // expect: 5

if (visitCount == 5) {
    print "  -> 모든 노드를 방문했다";
} else {
    print "  -> 일부 노드를 방문하지 못했다";
}

print "step 7: 산술/비교 연산자 확인";
var x = 10;
var y = 3;
print "  x =";
print x;
print "  y =";
print y;
print "  x + y =";
print x + y;   // expect: 13
print "  x - y =";
print x - y;   // expect: 7
print "  x * y =";
print x * y;   // expect: 30
print "  x / y =";
print x / y;   // expect: 3.3333333333333335
print "  x % y =";
print x % y;   // expect: 1
print "  x > y =";
print x > y;   // expect: true
print "  x < y =";
print x < y;   // expect: false
print "  x >= y =";
print x >= y;  // expect: true
print "  x <= y =";
print x <= y;  // expect: false
print "  x =< y =";
print x =< y;  // expect: false
print "  x => y =";
print x => y;  // expect: true
print "  x == y =";
print x == y;  // expect: false
print "  x != y =";
print x != y;  // expect: true

print "step 8: 논리/단항 연산자 확인";
print "  true and false =";
print true and false;  // expect: false
print "  true or false =";
print true or false;   // expect: true
print "  !(x == y) =";
print !(x == y);        // expect: true

print "step 9: 문자열 연결 확인";
print "graph module: " + utils.MODULE_NAME; // expect: graph module: graph_utils

print "=== 데모 종료 ===";
