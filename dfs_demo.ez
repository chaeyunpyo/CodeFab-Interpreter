print "step 4: 그래프 생성 (Class 선언, 상속, 배열)";
//      0
//     / \
//    1   2
//    |   |
//    3---4
Class Graph {
    init(size) {
        This.size = size;
        This.adj = Array(size);
        for (var i = 0; i < size; i = i + 1) {
            This.adj[i] = Array(size);
            for (var j = 0; j < size; j = j + 1) {
                This.adj[i][j] = false;
            }
        }
    }

    addEdge(a, b) {
        This.adj[a][b] = true;
        This.adj[b][a] = true;
    }

    hasEdge(a, b) {
        return This.adj[a][b];
    }
}

// --- 상속 + super ---
Class WeightedGraph : Graph {
    addEdge(a, b) {
        Super.addEdge(a, b);
        print "  edge added:";
        print a;
        print b;
        print "  weight =";
        print utils.edgeWeight(a, b);
    }
}

var g = WeightedGraph(5);
print "  Graph 인스턴스인가?";
print (g instanceof Graph);         // expect: true
print "  WeightedGraph 인스턴스인가?";
print (g instanceof WeightedGraph); // expect: true

print "간선 5개 추가";
g.addEdge(0, 1);
g.addEdge(0, 2);
g.addEdge(1, 3);
g.addEdge(2, 4);
g.addEdge(3, 4);

print "step 5: 재귀 함수 Test";
// --- 전역 변수 (함수 호출이 끝나도 값이 유지된다) ---
var visitCount = 0;

// --- 함수 선언 / 재귀 호출 / return / 논리 연산자(and) / 단항(!) ---
Func dfs(graph, node, visited) {
    if (visited[node] == true) {
        return;
    }
    visited[node] = true;
    visitCount = visitCount + 1;
    print "  visit node";
    print node;

    print_line;
    print_val;
    print_line;
    var neighbor = 0;
    for (neighbor = 0; neighbor < graph.size; neighbor = neighbor + 1) {
        if (graph.hasEdge(node, neighbor) and !visited[neighbor]) {
            dfs(graph, neighbor, visited);
        }
    }
}

var visited = Array(5);
for (var i = 0; i < 5; i = i + 1) {
    visited[i] = false;
}
print "  초기 방문 배열:";
print visited;   // expect: [false, false, false, false, false]

print "DFS 시작 (시작 노드 = 0)";
dfs(g, 0, visited);
print "DFS 종료";

print "  최종 방문 배열:";
print visited;      // expect: [true, true, true, true, true]
print "  총 방문 횟수(전역 변수 visitCount):";
print visitCount;   // expect: 5

if (visitCount == 5) {
    print "  -> 모든 노드를 방문했다";
} else {
    print "  -> 일부 노드를 방문하지 못했다";
}

