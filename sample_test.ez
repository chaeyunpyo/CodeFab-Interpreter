// --- 산술 연산자 우선순위 (곱셈/나눗셈이 덧셈/뺄셈보다 먼저) ---
print 1 + 2 * 3;        // expect: 7
print (1 + 2) * 3;      // expect: 9
print 10 - 4 - 3;       // expect: 3
print 8 / 2 / 2;        // expect: 2
print -3 + 2;           // expect: -1

// --- 비교 / 동등성 ---
print 1 < 2;             // expect: true
print 3 > 5;             // expect: false
print 3 == 3;            // expect: true
print 3 != 3;            // expect: false
print 3 >= 3;            // expect: true
print 2 <= 1;            // expect: false

// --- 문자열 연결 (+) ---
print "Hello, " + "CodeFab!";   // expect: Hello, CodeFab!

// --- 숫자 출력 포맷 (정수는 .0 없이 출력) ---
print 5;                 // expect: 5
print 5.0;               // expect: 5
print 3.14;              // expect: 3.14

// --- boolean 리터럴 / 논리 연산자 ---
print true;               // expect: true
print false;              // expect: false
print true and false;     // expect: false
print true or false;      // expect: true
print !true;              // expect: false

// --- 변수 선언 & 사용 ---
var a = 10;
var b = 20;
print a + b;              // expect: 30

// --- 재할당 ---
a = a + 5;
print a;                  // expect: 15

// --- 블록 스코프 & 변수 shadowing ---
var x = "global";
{
  var x = "inner";
  print x;                 // expect: inner
}
print x;                   // expect: global

// --- 안쪽 블록에서 바깥 변수 수정 ---
var count = 0;
{
  count = count + 1;
}
print count;               // expect: 1

// --- 중첩 스코프 변수 조회 순서 ---
var ga = 3;
{
  var scoped = 2;
  {
    print_line;
    print_val;
    print_line;
    var scoped = 7;
    {
      print scoped;         // expect: 7
      print ga;             // expect: 3
    }
    print scoped;           // expect: 7
  }
}

// --- if / else ---
if (true) print "bbq";                       // expect: bbq
if (false) print "no"; else print "kfc";     // expect: kfc

// --- else는 가장 가까운 if에 결합 (dangling else) ---
if (true)
{
  if (false) print "kfc";
  else print "bbq";                          // expect: bbq
}

// --- for 반복문 ---
for (var j = 0; j < 3; j = j + 1) { print j; }  // expect: 0, 1, 2

// --- for 루프 안에서 바깥 스코프 변수 갱신 ---
var total = 0;
for (var i = 0; i < 5; i = i + 1) {
  total = total + i;
}
print total;               // expect: 10
